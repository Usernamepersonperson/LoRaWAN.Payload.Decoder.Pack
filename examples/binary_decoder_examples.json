{
  "binary_decoder_examples": [
    {
      "description": "Temperature + humidity (port 1)",
      "fPort": 1,
      "payload_hex": "0A0741",
      "payload_bytes": [
        10,
        7,
        65
      ],
      "expected_output": {
        "temperature": 25.67,
        "humidity": 65
      }
    },
    {
      "description": "Sub-zero temperature (port 1)",
      "fPort": 1,
      "payload_hex": "F85432",
      "payload_bytes": [
        248,
        84,
        50
      ],
      "expected_output": {
        "temperature": -19.64,
        "humidity": 50
      }
    },
    {
      "description": "GPS, Berlin (port 2)",
      "fPort": 2,
      "payload_hex": "0321644800CC8B1A",
      "payload_bytes": [
        3,
        33,
        100,
        72,
        0,
        204,
        139,
        26
      ],
      "expected_output": {
        "latitude": 52.520008,
        "longitude": 13.404954
      }
    },
    {
      "description": "GPS, southern + western hemisphere: both negative (port 2)",
      "fPort": 2,
      "payload_hex": "FDFB33ECFBC9FE32",
      "payload_bytes": [
        253,
        251,
        51,
        236,
        251,
        201,
        254,
        50
      ],
      "expected_output": {
        "latitude": -33.86882,
        "longitude": -70.64827
      }
    },
    {
      "description": "Multi-sensor frame (port 3)",
      "fPort": 3,
      "payload_hex": "5509293C04B0",
      "payload_bytes": [
        85,
        9,
        41,
        60,
        4,
        176
      ],
      "expected_output": {
        "battery": 85,
        "temperature": 23.45,
        "humidity": 60,
        "light": 1200
      }
    },
    {
      "description": "Payload shorter than the frame (port 1)",
      "fPort": 1,
      "payload_hex": "0A07",
      "payload_bytes": [
        10,
        7
      ],
      "expected_output": {
        "error": "Payload too short"
      }
    },
    {
      "description": "Port without a decoder",
      "fPort": 99,
      "payload_hex": "00",
      "payload_bytes": [
        0
      ],
      "expected_output": {
        "error": "No decoder for port 99"
      }
    }
  ]
}